{
  "configurations": [
    {
      "name": "Windhawk Clang x64",
      "includePath": [
        "${workspaceFolder}/**",
        "C:/Program Files/Windhawk/Compiler/include",
        "C:/Program Files/Windhawk/Compiler/x86_64-w64-mingw32/include"
      ],
      "defines": [
        "UNICODE",
        "_UNICODE",
        "WINVER=0x0A00",
        "_WIN32_WINNT=0x0A00",
        "_WIN32_IE=0x0A00",
        "NTDDI_VERSION=0x0A000008",
        "__USE_MINGW_ANSI_STDIO=0",
        "WH_MOD",
        "WH_EDITING"
      ],
      "forcedInclude": [
        "C:/Program Files/Windhawk/Compiler/include/windhawk_api.h"
      ],
      "compilerPath": "C:/Program Files/Windhawk/Compiler/bin/clang++.exe",
      "cStandard": "c17",
      "cppStandard": "c++23",
      "intelliSenseMode": "windows-clang-x64",
      "compilerArgs": [
        "-target",
        "x86_64-w64-mingw32"
      ]
    }
  ],
  "version": 4
}
