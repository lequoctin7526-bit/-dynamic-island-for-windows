<UserControl x:Class="DynamicIslandApp.Controls.WaveformVisualizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="18" Width="24">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border x:Name="Bar1" Width="3" Height="6" CornerRadius="1.5" Background="#4CC9F0" Margin="1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar2" Width="3" Height="14" CornerRadius="1.5" Background="#4CC9F0" Margin="1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar3" Width="3" Height="8" CornerRadius="1.5" Background="#4CC9F0" Margin="1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar4" Width="3" Height="12" CornerRadius="1.5" Background="#4CC9F0" Margin="1,0" VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
