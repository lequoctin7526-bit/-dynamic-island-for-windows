<Window x:Class="DynamicIslandApp.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt Dynamic Island"
        Width="520" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#0E1218"
        Foreground="#E0E0E0">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#1A222D"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🏝️ Cài đặt Dynamic Island (Liquid Glass)" FontSize="18" FontWeight="Bold" Foreground="#4CC9F0"/>
            <TextBlock Text="Tùy chỉnh giao diện, hiệu ứng chuyển động và tối ưu hóa hệ thống" FontSize="12" Foreground="#8A92A0" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Settings Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <!-- 1. Tính năng cốt lõi -->
                <GroupBox Header="Tính năng chính" Foreground="#4CC9F0" Margin="0,0,0,12" Padding="12">
                    <StackPanel>
                        <CheckBox x:Name="ChkEnabled" Content="Kích hoạt Dynamic Island"/>
                        <CheckBox x:Name="ChkLiquidGlass" Content="Bật hiệu ứng kính trong suốt Liquid Glass"/>
                        <CheckBox x:Name="ChkLowPerf" Content="Chế độ tối ưu máy yếu (Low Performance Mode)"/>
                        <CheckBox x:Name="ChkStartup" Content="Khởi động cùng Windows"/>
                        <CheckBox x:Name="ChkWaveform" Content="Hiển thị sóng nhạc chuyển động khi phát nhạc"/>
                    </StackPanel>
                </GroupBox>

                <!-- 2. Giao diện & Chủ đề -->
                <GroupBox Header="Giao diện &amp; Chủ đề" Foreground="#4CC9F0" Margin="0,0,0,12" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Theme -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Chủ đề hiển thị:" VerticalAlignment="Center" Margin="0,6"/>
                        <ComboBox x:Name="CmbTheme" Grid.Row="0" Grid.Column="1" Margin="0,6">
                            <ComboBoxItem Content="Tối (Dark Mode)"/>
                            <ComboBoxItem Content="Sáng (Light Mode)"/>
                            <ComboBoxItem Content="Tự động theo Windows"/>
                        </ComboBox>

                        <!-- Position -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vị trí hiển thị:" VerticalAlignment="Center" Margin="0,6"/>
                        <ComboBox x:Name="CmbPosition" Grid.Row="1" Grid.Column="1" Margin="0,6">
                            <ComboBoxItem Content="Chính giữa cạnh trên (Top Center)"/>
                            <ComboBoxItem Content="Góc trên bên trái (Top Left)"/>
                            <ComboBoxItem Content="Góc trên bên phải (Top Right)"/>
                        </ComboBox>

                        <!-- Glass Opacity -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Độ trong suốt kính:" VerticalAlignment="Center" Margin="0,6"/>
                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,6">
                            <TextBlock x:Name="TxtOpacityVal" Text="88%" Width="40" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <Slider x:Name="SldOpacity" Minimum="0.3" Maximum="1.0" Value="0.88" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </GroupBox>

                <!-- 3. Chuyển động & Hiệu ứng -->
                <GroupBox Header="Hiệu ứng Animation" Foreground="#4CC9F0" Margin="0,0,0,12" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Speed -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tốc độ chuyển động:" VerticalAlignment="Center" Margin="0,6"/>
                        <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,6">
                            <TextBlock x:Name="TxtSpeedVal" Text="1.0x" Width="40" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <Slider x:Name="SldSpeed" Minimum="0.5" Maximum="2.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Notification duration -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Thời gian thông báo (giây):" VerticalAlignment="Center" Margin="0,6"/>
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,6">
                            <TextBlock x:Name="TxtDurationVal" Text="4s" Width="40" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <Slider x:Name="SldDuration" Minimum="2" Maximum="10" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </GroupBox>

                <!-- Test Notification Button -->
                <Button Content="🔔 Gửi thông báo thử nghiệm" Background="#1D2A3A" Foreground="#4CC9F0" Height="32" Margin="0,4" Click="OnTestNotificationClick"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Đặt lại mặc định" Width="120" Height="32" Background="#222B36" Foreground="#E0E0E0" Margin="0,0,10,0" Click="OnResetClick"/>
            <Button Content="Lưu &amp; Áp dụng" Width="120" Height="32" Background="#4CC9F0" Foreground="#0E1218" FontWeight="Bold" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</Window>
